# Leads / Supabase settings — copy to .env.local and fill in real values.
# NEVER commit a real .env.local file (it is gitignored). The service-role
# key is server-only: it bypasses Row Level Security, so never put it in
# code, never expose it to the browser, and never paste it in chat.

# Public Supabase project URL (safe to expose; it is the NEXT_PUBLIC_ var).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key from Supabase: Project Settings -> API -> anon /
# publishable. Public by design — it is safe to expose to the browser
# (NEXT_PUBLIC_). The login page and the auth session use it;
# Row Level Security still applies to every query it makes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key from Supabase: Project Settings -> API -> service_role.
# Server only. Used only by lib/supabase.ts in API routes / server pages.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Leave this unset to use the free, grounded mode (no LLM call).
# If you set it, /api/chat will use the LLM, but ONLY with the retrieved
# business chunks as context, and it must say it does not know otherwise.
OPENAI_API_KEY=<redacted>

# Optional. The public URL of this site (no trailing slash), e.g.
# https://ai-chatbot-site-tawny.vercel.app. When set, invite emails use
# it for the invite link instead of the request's Host header — set it
# in production so a forged Host header can never redirect an invite.
# Leave it unset in dev (localhost is worked out from the request).
NEXT_PUBLIC_SITE_URL=

# Shop payments (Stripe Checkout). Optional — leave unset and the shop
# still lists products and the cart still works, but checkout says
# "Checkout is not set up yet". When set, use a Stripe TEST secret key
# first (dashboard.stripe.com/test/apikeys, "sk_test_..."). Pay with
# the test card 4242 4242 4242 4242, any future expiry, any CVC.
# Only swap in a LIVE secret key (sk_live_...) if the owner explicitly
# chooses to take real money — never put a live key in for this demo
# without that. Server only (lib/stripe.ts); never expose it to the
# browser and never paste it in chat. See SHOP.md.
STRIPE_SECRET_KEY=
