    {
      "parameters": {
        "resource": "chat",
        "operation": "message",
        "model": "gpt-4o-mini",
        "messages": {
          "message": [
            {
              "role": "system",
              "content": "You write short appointment reminders for Lumen Hair Studio, a hair salon. Use only the details given \u2014 never invent a date or time. The booking has no date in this demo, so write the reminder without a specific time and leave a [day/time] placeholder the owner fills in before sending. Keep it under 40 words. Sign off as 'Lumen Hair Studio'."
            },
            {
              "role": "user",
              "content": "=Appointment booked: {{ $json.name }} \u2014 {{ $json.service }}. Contact: {{ $json.contact }}. Write a short reminder the owner can send the day before the appointment."
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 300
        }
      },
      "id": "17949fc7-321d-420f-b76c-4094be5da52a",
      "name": "Draft reminder with AI",
